# 复制本文件为 .streamlit/secrets.toml 并填入真实值（仅本地测试用）。
#
# 部署到 Streamlit Cloud 时，请在应用 Dashboard 的「Settings → Secrets」里
# 添加同名键，不要把本文件（含真实密码/Key）提交到 GitHub。
# .streamlit/secrets.toml 已在 .gitignore 中忽略。

# ---- 数据库（Supabase/Postgres）----
# 格式：postgresql://<数据库用户名>:<密码>@<主机>:<端口>/<库名>
# Supabase 的连接串在 Dashboard → Project Settings → Database 里可复制，
# 把 [YOUR-PASSWORD] 换成你的数据库密码。
# 不填这一项时，应用自动回退到本地 SQLite。
DATABASE_URL = "postgresql://postgres.lnpootreagsqzanofqfc:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# ---- DeepSeek API Key（评分与追问用）----
# 不填时内容分析会回退到本地 Ollama。
PRISMAI_DEEPSEEK_API_KEY = "sk-在这里填你的DeepSeek密钥"
